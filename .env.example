DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# One or more JSON-RPC URLs, comma-separated (extra ones act as fallbacks)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org
# 32+ chars. Generate with: openssl rand -hex 32  -- LOSE THIS AND ALL WALLETS ARE UNRECOVERABLE
MASTER_SECRET=
# Optional
GUILD_ID=
DB_PATH=./wallets.db
NATIVE_SYMBOL=ETH
NETWORK_NAME=Sepolia
EXPLORER_TX_URL=https://sepolia.etherscan.io/tx/
# PNG shown in the middle of deposit QR codes (defaults to the bot's avatar)
LOGO_PATH=
# Wallets per Discord user (1-10)
MAX_WALLETS=5
CONFIRMATIONS=2
POLL_MS=12000
# Low-RAM hosts: scrypt memory cost as log2(N). 15 = 32 MB (default), 14 = 16 MB, 13 = 8 MB.
# Applies to wallets created/imported or PIN-changed after you set it; existing wallets keep working.
SCRYPT_LOG_N=15
# After downtime the deposit watcher skips anything older than this many blocks
MAX_CATCHUP_BLOCKS=600
